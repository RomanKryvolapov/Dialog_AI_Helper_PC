{
  "model": "claude-opus-5-5",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "fallbackModel": [
    "claude-sonnet-5-5"
  ],
  "idleCompaction": false,
  "showThinkingSummaries": true,
  "cleanupPeriodDays": 90,
  "env": {
    "MCP_TIMEOUT": "60000",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "500",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "10",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5"
  },
  "permissions": {
    "allow": [
      "Bash",
      "WebFetch",
      "Skill",
      "mcp__serena__*",
      "Bash(grep:*)",
      "mcp__acp__Edit",
      "mcp__acp__Write",
      "Bash(mkdir -p .claude/skills)",
      "Bash(git mv *)",
      "Read(.claude/skills/**)",
      "Edit(.claude/skills/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-limits\" --mode statusline",
    "refreshInterval": 30
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-limits\" --mode inject --event SessionStart",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-limits\" --mode inject --event UserPromptSubmit",
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/play-sound\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/play-sound\"",
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/play-sound\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
