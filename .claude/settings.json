{
  "ultracode": true,
  "model": "claude-opus-5",
  "effortLevel": "xhigh",
  "env": {
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "30"
  },
  "permissions": {
    "allow": [
      "Bash",
      "WebFetch",
      "Skill",
      "mcp__serena__*",
      "Bash(grep:*)",
      "mcp__acp__Edit",
      "mcp__acp__Write",
      "Bash(mkdir -p .claude/skills)",
      "Bash(git mv *)",
      "Read(.claude/skills/**)",
      "Edit(.claude/skills/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-limits\" --mode statusline"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-limits\" --mode inject --event SessionStart",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-limits\" --mode inject --event UserPromptSubmit",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/usage-limits\" --mode gate",
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/play-sound\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/play-sound\"",
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/play-sound\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
