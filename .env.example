# Fallback values, used while the matching field in the app is still empty. See README.
# Syntax: KEY=VALUE. `#` starts a comment — quote a value that contains " #".

# --- General ---
#DIALOG_AUDIO_INPUT_DEVICE="Microphone (Realtek(R) Audio)"
#DIALOG_QUESTION_LANGUAGE=en                     # the language being spoken, for the recognisers (Whisper, Speechmatics)

# --- LLM ---
# Translation methods 1-3, tried in order when the one before fails; each is <how it is heard>:<model>.
#   voice:<model> — the model hears the audio itself: voice:gemini-3.5-flash-lite, voice:gpt-audio-1.5
#   <recogniser>:<model> — whisper-batch, whisper-streaming, sherpa-onnx or speechmatics, then the model that translates:
#   gemini-3.5-flash-lite, gemma-4-31b-it, gemma-4-26b-a4b-it, gpt-6.1-terra, claude-sonnet-5-5
# A dialog starts on method 1 and switches to the next for the rest of the dialog when the one in use fails.
#DIALOG_TRANSLATION_METHODS=voice:gemini-3.5-flash-lite,voice:gpt-audio-1.5,whisper-batch:gpt-6.1-terra
# Older keys, used when the line above is not set: one text method on the recogniser named here.
#DIALOG_LLM_MODEL_ID=gpt-6.1-terra
#DIALOG_VOICE_RECOGNITION_ENGINE=WHISPER_BATCH    # or WHISPER_STREAMING, SHERPA_ONNX
#DIALOG_USE_STREAMING_RESPONSE=true
#DIALOG_GOOGLE_API_KEY=
#DIALOG_OPENAI_API_KEY=
#DIALOG_CLAUDE_API_KEY=
#DIALOG_SPEECHMATICS_API_KEY=

# Prompts and model parameters have no keys here: they are edited on Settings → Main prompt, Voice prompt and LLM.

# --- Phrases: where speech is cut (Whisper and the voice models, in part Speechmatics) ---
#DIALOG_WHISPER_SILENCE_THRESHOLD_PERCENTS=10
#DIALOG_WHISPER_MAX_SILENCE_MS=500
#DIALOG_WHISPER_MAX_CHUNK_DURATION_MS=5000

# --- Whisper (batch + streaming) ---
#DIALOG_WHISPER_MODEL_PATH=D:\models\faster-whisper-large-v3
#DIALOG_WHISPER_MAX_CONCURRENT_PROCESSES=5
#DIALOG_WHISPER_STREAMING_STEP_MS=700
#DIALOG_WHISPER_STREAMING_MIN_CHARS=20

# --- Sherpa-ONNX ---
#DIALOG_SHERPA_MODEL_PATH=D:\models\sherpa-onnx-streaming-zipformer-en
#DIALOG_SHERPA_DECODING_METHOD=greedy_search      # or modified_beam_search
#DIALOG_SHERPA_NUM_THREADS=2
#DIALOG_SHERPA_MAX_ACTIVE_PATHS=4
#DIALOG_SHERPA_SPLIT_MAX_WORDS=12
#DIALOG_SHERPA_MAX_HANG_MS=8000

# --- Not on the Settings screen ---
#DIALOG_LAST_OPENED_TAB=2                         # 0 = Messages, 1 = Questions, 2 = Settings
